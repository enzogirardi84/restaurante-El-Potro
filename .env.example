# Supabase credentials used by the browser app.
# Copy this file to .env.local and fill in your own project values.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Local fallback credentials. Supabase Auth is used first when the user enters
